APP_NAME="Agenda eGov Sambas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agenda_egov
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120

FILESYSTEM_DISK=public
CACHE_STORE=file

BCRYPT_ROUNDS=12

VITE_APP_NAME="${APP_NAME}"

ADMIN_NAME="Administrator Agenda eGov"
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@agenda-egov.local
ADMIN_PASSWORD=password

# Buka pendaftaran umum (true = boleh daftar, false = hanya first-time setup)
REGISTRATION_OPEN=false

# WhatsApp Fonnte API
FONNTE_TOKEN=
FONNTE_DEVICE=

# Firebase Cloud Messaging
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=storage/app/firebase-credentials.json
# Alternative: paste entire JSON content (for Railway/cloud deployment)
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"xxx",...}

# Firebase Client (untuk frontend)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
